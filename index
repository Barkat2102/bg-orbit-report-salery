    <style>
        :root {
            --bg-main: #0b0f19;
            --bg-card: #151b2c;
            --border-color: rgba(255, 255, 255, 0.08);
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --primary: #3b82f6;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --font-family: 'Plus Jakarta Sans', sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-primary);
            font-family: var(--font-family);
            padding: 2rem;
            min-height: 100vh;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        header {
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        h1 {
            font-size: 1.8rem;
            font-weight: 800;
            background: linear-gradient(135deg, #60a5fa, #3b82f6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        p.subtitle {
            color: var(--text-secondary);
            font-size: 0.95rem;
            margin-top: 0.25rem;
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .stat-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
        }

        .stat-label {
            color: var(--text-secondary);
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.5rem;
        }

        .stat-val {
            font-size: 2rem;
            font-weight: 700;
        }

        .stat-val.success { color: var(--success); }
        .stat-val.primary { color: var(--primary); }
        .stat-val.danger { color: var(--danger); }
        .stat-val.warning { color: var(--warning); }

        /* Filter controls */
        .controls {
            display: flex;
            gap: 1rem;
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
        }

        .search-input, .filter-select {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            padding: 0.75rem 1rem;
            border-radius: 8px;
            font-family: var(--font-family);
            font-size: 0.9rem;
            outline: none;
        }

        .search-input {
            flex-grow: 1;
            min-width: 250px;
        }

        .search-input:focus, .filter-select:focus {
            border-color: var(--primary);
        }

        /* User Card List */
        .users-list {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .user-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 4px 25px rgba(0, 0, 0, 0.2);
            transition: transform 0.2s, border-color 0.2s;
        }

        .user-card:hover {
            border-color: rgba(59, 130, 246, 0.3);
        }

        .user-header {
            padding: 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border-color);
            cursor: pointer;
            user-select: none;
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .user-avatar {
            width: 48px;
            height: 48px;
            background: linear-gradient(135deg, #1e3a8a, #3b82f6);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 1.2rem;
            color: #fff;
        }

        .user-meta h3 {
            font-size: 1.1rem;
            font-weight: 700;
        }

        .user-badges {
            display: flex;
            gap: 0.5rem;
            margin-top: 0.25rem;
        }

        .badge {
            font-size: 0.75rem;
            padding: 0.2rem 0.6rem;
            border-radius: 99px;
            font-weight: 600;
        }

        .badge.active { background-color: rgba(16, 185, 129, 0.15); color: var(--success); }
        .badge.inactive { background-color: rgba(239, 68, 68, 0.15); color: var(--danger); }
        .badge.level { background-color: rgba(59, 130, 246, 0.15); color: var(--primary); }

        .user-summary-stats {
            display: flex;
            gap: 2rem;
            text-align: right;
        }

        .summary-stat-item {
            display: flex;
            flex-direction: column;
        }

        .summary-stat-label {
            font-size: 0.75rem;
            color: var(--text-secondary);
            text-transform: uppercase;
        }

        .summary-stat-val {
            font-size: 1.1rem;
            font-weight: 700;
        }

        /* Accordion Content */
        .user-content {
            padding: 1.5rem;
            display: none;
            border-top: 1px solid var(--border-color);
            background-color: rgba(0, 0, 0, 0.08);
        }

        .user-content.open {
            display: block;
        }

        /* Timeline styling */
        .timeline-section {
            margin-bottom: 2rem;
        }

        .timeline-section:last-child {
            margin-bottom: 0;
        }

        .level-title {
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 1rem;
            color: var(--primary);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .timeline {
            position: relative;
            padding-left: 24px;
            border-left: 2px solid var(--border-color);
            margin-left: 8px;
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
        }

        .timeline-item {
            position: relative;
        }

        .timeline-dot {
            position: absolute;
            left: -32px;
            top: 4px;
            width: 14px;
            height: 14px;
            border-radius: 99px;
            border: 2px solid var(--bg-card);
        }

        .timeline-dot.success { background-color: var(--success); box-shadow: 0 0 8px var(--success); }
        .timeline-dot.recovered { background-color: var(--primary); box-shadow: 0 0 8px var(--primary); }
        .timeline-dot.danger { background-color: var(--danger); box-shadow: 0 0 8px var(--danger); }

        .timeline-info {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .timeline-header {
            font-weight: 600;
            font-size: 0.95rem;
        }

        .timeline-date {
            font-size: 0.8rem;
            color: var(--text-secondary);
        }

        .timeline-status {
            font-size: 0.85rem;
            font-weight: 600;
            padding: 0.25rem 0.75rem;
            border-radius: 6px;
        }

        .timeline-status.success { background-color: rgba(16, 185, 129, 0.1); color: var(--success); }
        .timeline-status.recovered { background-color: rgba(59, 130, 246, 0.1); color: var(--primary); }
        .timeline-status.danger { background-color: rgba(239, 68, 68, 0.1); color: var(--danger); }

        .timeline-desc {
            font-size: 0.85rem;
            color: var(--text-secondary);
            margin-top: 0.2rem;
        }

        /* Unmatched extra payments */
        .extra-payments {
            background-color: rgba(255, 255, 255, 0.02);
            border: 1px dashed var(--border-color);
            border-radius: 8px;
            padding: 1rem;
            margin-top: 1rem;
        }

        .extra-payments h4 {
            font-size: 0.85rem;
            text-transform: uppercase;
            color: var(--text-secondary);
            margin-bottom: 0.5rem;
        }

        .extra-list {
            list-style: none;
            font-size: 0.85rem;
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
        }

        /* Chevron indicator */
        .chevron {
            transition: transform 0.2s;
            fill: var(--text-secondary);
        }

        .user-header.open .chevron {
            transform: rotate(180deg);
        }

        /* Recovery Note Alert */
        .recovery-alert {
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(30, 58, 138, 0.15));
            border: 1px solid rgba(59, 130, 246, 0.25);
            border-radius: 12px;
            padding: 1.25rem;
            margin-bottom: 2rem;
            display: flex;
            gap: 1rem;
            align-items: center;
        }

        .recovery-alert svg {
            color: var(--primary);
            flex-shrink: 0;
        }

        .recovery-alert-content h4 {
            font-size: 0.95rem;
            font-weight: 700;
            margin-bottom: 0.2rem;
        }

        .recovery-alert-content p {
            font-size: 0.85rem;
            color: var(--text-secondary);
            line-height: 1.4;
        }

    </style>
</head>
