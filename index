<script>
    function toggleAccordion(header) {
        const card = header.parentElement;
        const content = card.querySelector('.user-content');
        
        header.classList.toggle('open');
        content.classList.toggle('open');
    }

    function filterUsers() {
        const query = document.getElementById('searchBar').value.toLowerCase();
        const level = document.getElementById('levelFilter').value;
        const status = document.getElementById('statusFilter').value;
        
        const cards = document.querySelectorAll('.user-card');
        
        cards.forEach(card => {
            const username = card.getAttribute('data-username');
            const userLevel = card.getAttribute('data-level');
            const userActive = card.getAttribute('data-active');
            
            const matchesQuery = username.includes(query);
            const matchesLevel = (level === 'ALL' || userLevel === level);
            const matchesStatus = (status === 'ALL' || 
                                   (status === 'ACTIVE' && userActive === 'active') || 
                                   (status === 'INACTIVE' && userActive === 'inactive'));
            
            if (matchesQuery && matchesLevel && matchesStatus) {
                card.style.display = 'block';
            } else {
                card.style.display = 'none';
            }
        });
    }
</script>
